# Copy to .env locally (never commit .env); generate a unique secret per environment.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_URL=
# Optional direct Neon URL for migrations; runtime DATABASE_URL can use the pooler.
MIGRATION_DATABASE_URL=
SITE_URL=http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000
REQUIRE_EDGE_PROXY=false
EDGE_PROXY_SECRET=
DJANGO_TIME_ZONE=Asia/Aden

# Public account routes remain disabled in production until a sender domain is verified,
# a Resend API key is provisioned, and real delivery is tested. Local DEBUG uses console email.
PUBLIC_AUTH_ENABLED=false
RESEND_DOMAIN_VERIFIED=false
RESEND_SENDING_DOMAIN=
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=

# Keep false until private object storage, review workflow, and retention are approved.
PHOTO_UPLOADS_ENABLED=false
PRIVATE_MEDIA_ROOT=
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
