{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile document in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Firebase Auth UID", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "description": "Display name of the user", "minLength": 1, "maxLength": 100 },
        "email": { "type": "string", "description": "Email address", "maxLength": 150 },
        "isVerified": { "type": "boolean", "description": "Whether the user email is verified" },
        "dateJoined": { "type": "string", "description": "ISO date string of account creation", "maxLength": 32 }
      },
      "required": ["id", "name", "email", "isVerified", "dateJoined"]
    },
    "ReportItem": {
      "title": "ReportItem",
      "description": "Lost or found report submitted by a verified user (no PII stored)",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Report title", "minLength": 3, "maxLength": 150 },
        "kind": { "type": "string", "enum": ["lost", "found"], "description": "Whether the item is lost or found" },
        "category": { "type": "string", "description": "Item category", "minLength": 2, "maxLength": 100 },
        "governorate": { "type": "string", "description": "Governorate", "minLength": 2, "maxLength": 100 },
        "city": { "type": "string", "description": "City or district", "minLength": 2, "maxLength": 150 },
        "eventDate": { "type": "string", "description": "Date lost or found", "maxLength": 32 },
        "status": { "type": "string", "enum": ["published", "closed", "pending"], "description": "Report lifecycle status" },
        "publicDescription": { "type": "string", "description": "Public description of item", "minLength": 10, "maxLength": 2000 },
        "ownerId": { "type": "string", "description": "Firebase Auth UID of the report owner", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerName": { "type": "string", "description": "Public display name of the report owner", "minLength": 1, "maxLength": 100 },
        "closedAt": { "type": "string", "description": "Closure date", "maxLength": 32 },
        "createdAt": { "type": "string", "description": "Creation ISO timestamp", "maxLength": 40 }
      },
      "required": ["title", "kind", "category", "governorate", "city", "eventDate", "status", "publicDescription", "ownerId", "ownerName", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile documents (owner-only read/write)"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/ReportItem" },
      "description": "Public lost and found reports without PII"
    }
  }
}
